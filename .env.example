OPENAI_API_KEY=""
OPENAI_MODEL_NAME="gpt-5.6"
GEMINI_API_KEY=""
GEMINI_MODEL_NAME="gemini-3.8-flash"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL_NAME="anthropic/claude-sonnet-5.5"

# Model names change often. Set these to a current model your provider offers.

# Flagship and reasoning controls. The CLI flags --flagship, --effort, and
# --max-tokens set these; you can also set them here. Each provider accepts a
# subset of effort levels (low|medium|high|xhigh|max).
# WATCHTOWER_FLAGSHIP="1"
# WATCHTOWER_EFFORT="high"
# WATCHTOWER_MAX_TOKENS="8000"

# add your own custom providers
# WATCHTOWER_PROVIDER="https://api.custom.com/v1"
# WATCHTOWER_MODEL="custom-model-v1"
# WATCHTOWER_APIKEY_NAME="MY_CUSTOM_KEY"
# MY_CUSTOM_KEY="sk-..."
# DGRID_API_KEY=
# or any other key names.

# Wordlist for content-discovery tools (ffuf, gobuster). Optional.
# Defaults to a common system list, then a small bundled list.
# WATCHTOWER_WORDLIST="/usr/share/seclists/Discovery/Web-Content/common.txt"

# Path to ProjectDiscovery's httpx scanner. Optional; set it if Python's httpx
# client command shadows the scanner on your PATH.
# WATCHTOWER_HTTPX_BIN="/root/go/bin/httpx"